# Copy to .env and fill in. PRIVATE_KEY defaults to anvil's published account-0
# key -- the same 0xac09...ff80 that anvil prints on startup. It is deliberately
# not a secret: it holds nothing on any real network and is funded only inside
# the local chain. Override with your own key if you prefer, but do not commit
# anything that is not anvil-default.
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
OPENROUTER_API_KEY=***
HF_TOKEN=
HF_REPO_ID=yourorg/your-repo
